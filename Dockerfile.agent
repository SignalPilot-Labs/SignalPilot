FROM node:22-bookworm-slim
ARG CLAUDE_CODE_VERSION=2.1.156
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
    && python3 -m venv /opt/dbt \
    && /opt/dbt/bin/pip install --no-cache-dir dbt-core==1.11.11 dbt-duckdb==1.10.1 \
    && useradd --uid 10002 --create-home agent
COPY signalpilot-plugin /opt/signalpilot-plugin
COPY signalpilot/gateway/gateway/agent_execution/entrypoint.py /opt/agent/entrypoint.py
COPY signalpilot/gateway/gateway/agent_execution/artifacts.py /opt/agent/gateway/agent_execution/artifacts.py
COPY signalpilot/gateway/gateway/workspace_store/paths.py /opt/agent/gateway/workspace_store/paths.py
ENV PYTHONPATH=/opt/agent PYTHONUNBUFFERED=1 PATH=/opt/dbt/bin:$PATH
USER 10002:10002
WORKDIR /work
CMD ["python3", "/opt/agent/entrypoint.py"]
