FROM sp-dbt-signalpilot-opus5-cc21227-ade-broad-fix1-starter:latest

USER root

# Keep the sanitized current harness while advancing its Claude runtime.
ARG CLAUDE_CODE_VERSION=2.1.228
ARG AGENT_SDK_VERSION=0.2.136
RUN rm -rf /app/signalpilot/gateway
COPY signalpilot/gateway/ /app/signalpilot/gateway/
RUN pip install --no-cache-dir /app/signalpilot/gateway \
    && npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
    && pip install --no-cache-dir "claude-agent-sdk==${AGENT_SDK_VERSION}"

# Replace the installed prompt/tool bundle with the audited source in this checkout.
RUN rm -rf /app/benchmark/signalpilot-plugin \
    /home/agentuser/.claude/plugins
COPY benchmark/signalpilot-plugin/ /app/benchmark/signalpilot-plugin/
COPY benchmark/prompts/dbt_local_system.md /app/benchmark/prompts/dbt_local_system.md
COPY benchmark/mcp_state_audit_config.json /app/benchmark/mcp_baked_config.json
RUN rm -rf /app/benchmark/signalpilot-plugin/agents/_archived \
    && rm -f /app/benchmark/signalpilot-plugin/marketing.md \
    && python -m py_compile \
      /app/benchmark/signalpilot-plugin/skills/dbt-workflow/inspect_model_state.py \
    && python /app/benchmark/signalpilot-plugin/skills/dbt-workflow/inspect_model_state.py --help >/dev/null \
    && gosu agentuser bash -c '\
      claude plugin marketplace add /app/benchmark/signalpilot-plugin/.claude-plugin/marketplace.json >/dev/null; \
      claude plugin install signalpilot-dbt@signalpilot --scope user >/dev/null; \
      test -f /home/agentuser/.claude/plugins/cache/signalpilot/signalpilot-dbt/1.0.0/skills/dbt-workflow/inspect_model_state.py; \
      grep -q inspect_model_state.py /home/agentuser/.claude/plugins/cache/signalpilot/signalpilot-dbt/1.0.0/skills/dbt-workflow/SKILL.md'

ENTRYPOINT ["bash"]
