{
  "version": 1,
  "title": "Revenue overview",
  "description": "Net revenue by month and by region for 2025, completed orders only.",
  "layout": { "columns": 12, "rowHeight": 72 },
  "datasets": {
    "monthly": {
      "file": "artifacts/revenue_monthly.csv",
      "source": {
        "kind": "sql",
        "connection": "warehouse",
        "sql": "select date_trunc('month', order_date) as month, region, sum(net_revenue) as revenue, count(*) as orders from fct_orders where order_status = 'completed' and order_date >= '2025-01-01' group by 1, 2 order by 1, 2"
      }
    },
    "by_region": {
      "file": "artifacts/revenue_by_region.csv",
      "source": {
        "kind": "sql",
        "connection": "warehouse",
        "sql": "select region, sum(net_revenue) as revenue, count(*) as orders, count(distinct customer_id) as customers, sum(net_revenue) / nullif(lag_revenue, 0) - 1 as growth from rpt_region_revenue where year = 2025 group by 1"
      }
    },
    "totals": {
      "rows": [
        { "revenue": 4821533.42, "orders": 18342, "growth": 0.118 }
      ]
    }
  },
  "filters": [
    {
      "id": "region",
      "label": "Region",
      "dataset": "monthly",
      "column": "region",
      "type": "in",
      "default": []
    },
    {
      "id": "period",
      "label": "Period",
      "dataset": "monthly",
      "column": "month",
      "type": "date_range",
      "default": { "from": "2025-01-01", "to": "2025-12-31" }
    }
  ],
  "charts": [
    {
      "id": "total_revenue",
      "type": "kpi",
      "title": "Net revenue 2025",
      "dataset": "totals",
      "value": { "column": "revenue", "format": "currency:USD" },
      "comparison": { "column": "growth", "label": "vs 2024", "format": "percentage" },
      "grid": { "x": 0, "y": 0, "w": 3, "h": 2 }
    },
    {
      "id": "total_orders",
      "type": "kpi",
      "title": "Completed orders",
      "dataset": "totals",
      "value": { "column": "orders", "format": "integer" },
      "grid": { "x": 3, "y": 0, "w": 3, "h": 2 }
    },
    {
      "id": "revenue_by_month",
      "type": "line",
      "title": "Revenue by month",
      "description": "Sum of net revenue per month across all regions.",
      "dataset": "monthly",
      "x": { "column": "month", "type": "date", "label": "Month" },
      "y": [ { "column": "revenue", "label": "Revenue", "format": "currency:USD" } ],
      "sort": { "column": "month", "direction": "asc" },
      "grid": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": "revenue_by_region_month",
      "type": "bar",
      "title": "Revenue by region and month",
      "dataset": "monthly",
      "x": { "column": "month", "type": "date", "label": "Month" },
      "y": [ { "column": "revenue", "label": "Revenue", "format": "compact" } ],
      "series": { "column": "region", "stack": true },
      "sort": { "column": "month" },
      "grid": { "x": 0, "y": 2, "w": 6, "h": 4 }
    },
    {
      "id": "region_share",
      "type": "pie",
      "title": "Share of revenue by region",
      "dataset": "by_region",
      "label": "region",
      "value": { "column": "revenue", "format": "currency:USD" },
      "donut": true,
      "sort": { "column": "revenue", "direction": "desc" },
      "limit": 8,
      "grid": { "x": 6, "y": 4, "w": 6, "h": 4 }
    },
    {
      "id": "region_table",
      "type": "table",
      "title": "Revenue by region",
      "dataset": "by_region",
      "columns": [
        { "column": "region", "label": "Region" },
        { "column": "revenue", "label": "Revenue", "format": "currency:USD" },
        { "column": "orders", "label": "Orders", "format": "integer" },
        { "column": "customers", "label": "Customers", "format": "integer" },
        { "column": "growth", "label": "Growth", "format": "percentage" }
      ],
      "sort": { "column": "revenue", "direction": "desc" },
      "limit": 20,
      "grid": { "x": 0, "y": 8, "w": 12, "h": 5 }
    }
  ]
}
