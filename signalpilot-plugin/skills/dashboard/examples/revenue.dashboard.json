{
  "version": 1,
  "title": "Revenue overview",
  "description": "Net revenue by month and by region for 2025, completed orders only.",
  "layout": { "columns": 12, "rowHeight": 72 },
  "datasets": {
    "monthly": {
      "connection": "warehouse",
      "sql": "with monthly as (select date_trunc('month', order_date) as month, case when country in ('US', 'CA', 'MX') then 'North America' when country in ('GB', 'DE', 'FR', 'NL') then 'Europe' else 'Rest of world' end as region, sum(net_revenue) as revenue, count(*) as orders from fct_orders where order_status = 'completed' and order_date >= '2024-01-01' group by 1, 2) select month, region, revenue, orders, sum(revenue) over (partition by region order by month rows between 11 preceding and current row) as revenue_ttm from monthly where month >= '2025-01-01' order by month, region"
    },
    "by_region": {
      "connection": "warehouse",
      "sql": "with yearly as (select case when country in ('US', 'CA', 'MX') then 'North America' when country in ('GB', 'DE', 'FR', 'NL') then 'Europe' else 'Rest of world' end as region, extract(year from order_date) as year, sum(net_revenue) as revenue, count(*) as orders, count(distinct customer_id) as customers from fct_orders where order_status = 'completed' and order_date >= '2024-01-01' group by 1, 2), growth as (select region, year, revenue, orders, customers, revenue / nullif(lag(revenue) over (partition by region order by year), 0) - 1 as growth from yearly) select region, revenue, orders, customers, growth from growth where year = 2025 order by revenue desc"
    },
    "totals": {
      "rows": [
        { "revenue": 4821533.42, "orders": 18342, "growth": 0.118 }
      ]
    }
  },
  "filters": [
    {
      "id": "region",
      "label": "Region",
      "dataset": "monthly",
      "column": "region",
      "type": "in",
      "default": []
    },
    {
      "id": "period",
      "label": "Period",
      "dataset": "monthly",
      "column": "month",
      "type": "date_range",
      "default": { "from": "2025-01-01", "to": "2025-12-31" }
    }
  ],
  "charts": [
    {
      "id": "total_revenue",
      "type": "kpi",
      "title": "Net revenue 2025",
      "dataset": "totals",
      "value": { "column": "revenue", "format": "currency:USD" },
      "comparison": { "column": "growth", "label": "vs 2024", "format": "percentage" },
      "grid": { "x": 0, "y": 0, "w": 3, "h": 2 }
    },
    {
      "id": "total_orders",
      "type": "kpi",
      "title": "Completed orders",
      "dataset": "totals",
      "value": { "column": "orders", "format": "integer" },
      "grid": { "x": 3, "y": 0, "w": 3, "h": 2 }
    },
    {
      "id": "revenue_ttm",
      "type": "line",
      "title": "Trailing twelve month revenue",
      "description": "Sum of the last twelve months of net revenue, per region.",
      "dataset": "monthly",
      "x": { "column": "month", "type": "date", "label": "Month" },
      "y": [ { "column": "revenue_ttm", "label": "TTM revenue", "format": "currency:USD" } ],
      "series": { "column": "region" },
      "sort": { "column": "month", "direction": "asc" },
      "grid": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": "revenue_by_region_month",
      "type": "bar",
      "title": "Revenue by region and month",
      "dataset": "monthly",
      "x": { "column": "month", "type": "date", "label": "Month" },
      "y": [ { "column": "revenue", "label": "Revenue", "format": "compact" } ],
      "series": { "column": "region", "stack": true },
      "sort": { "column": "month" },
      "grid": { "x": 0, "y": 2, "w": 6, "h": 4 }
    },
    {
      "id": "region_share",
      "type": "pie",
      "title": "Share of revenue by region",
      "dataset": "by_region",
      "label": "region",
      "value": { "column": "revenue", "format": "currency:USD" },
      "donut": true,
      "sort": { "column": "revenue", "direction": "desc" },
      "limit": 8,
      "grid": { "x": 6, "y": 4, "w": 6, "h": 4 }
    },
    {
      "id": "region_table",
      "type": "table",
      "title": "Revenue by region",
      "dataset": "by_region",
      "columns": [
        { "column": "region", "label": "Region" },
        { "column": "revenue", "label": "Revenue", "format": "currency:USD" },
        { "column": "orders", "label": "Orders", "format": "integer" },
        { "column": "customers", "label": "Customers", "format": "integer" },
        { "column": "growth", "label": "Growth", "format": "percentage" }
      ],
      "sort": { "column": "revenue", "direction": "desc" },
      "limit": 20,
      "grid": { "x": 0, "y": 8, "w": 12, "h": 5 }
    },
    {
      "id": "revenue_and_growth",
      "type": "combo",
      "title": "Revenue and growth by region",
      "description": "Bars show 2025 revenue on the left axis. The line shows growth versus 2024 on the right axis.",
      "dataset": "by_region",
      "x": { "column": "region", "label": "Region" },
      "bars": [ { "column": "revenue", "label": "Revenue", "format": "currency:USD" } ],
      "lines": [ { "column": "growth", "label": "Growth", "format": "percentage" } ],
      "secondary_axis": true,
      "sort": { "column": "revenue", "direction": "desc" },
      "grid": { "x": 0, "y": 13, "w": 6, "h": 4 }
    },
    {
      "id": "revenue_heatmap",
      "type": "heatmap",
      "title": "Revenue by region and month",
      "dataset": "monthly",
      "x": { "column": "month", "type": "date", "label": "Month" },
      "y": { "column": "region" },
      "value": { "column": "revenue", "label": "Revenue", "format": "compact" },
      "show_values": true,
      "sort": { "column": "month" },
      "grid": { "x": 6, "y": 13, "w": 6, "h": 4 }
    }
  ]
}
